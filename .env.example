# Is file ko copy karke ".env" naam do aur apni values bharo.
# ".env" ko kabhi GitHub par upload mat karna.

# Required: OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Strongly recommended: koi bhi secret password. Deploy ke baad sirf wahi use kar payega
# jise ye password pata hai (warna koi bhi tumhare paise kharch kar sakta hai).
APP_PASSWORD=change-this-to-something-long

# Optional
ASSISTANT_NAME=Jarvis
LLM_MODEL=gpt-4o-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
DEFAULT_CITY=Delhi
DEFAULT_TIMEZONE=Asia/Kolkata
